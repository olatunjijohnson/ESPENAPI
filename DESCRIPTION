Package: ESPENAPI
Type: Package
Title: Access NTD Data from the ESPEN Portal API
Version: 0.3.0
Authors@R: c(
    person("Olatunji", "Johnson", role = c("cre", "aut"),
           email = "olatunjijohnson21111@gmail.com",
           comment = c(ORCID = "0000-0002-4080-0999")),
